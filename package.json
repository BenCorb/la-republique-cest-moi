{
	"name": "la-republique-cest-moi",
	"version": "0.0.1",
	"private": true,
	"description": "La République, c’est moi ! — jeu web solo de carrière politique satirique (site statique).",
	"type": "module",
	"engines": {
		"node": ">=26.13.1 <27",
		"npm": ">=11"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"serve:static": "node scripts/serve-static.ts",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"content:validate": "node scripts/validate-content.ts",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "playwright test",
		"test:e2e:install": "playwright install chromium"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@lucide/svelte": "1.79.0",
		"@playwright/test": "1.65.1",
		"@sveltejs/adapter-static": "4.0.1",
		"@sveltejs/kit": "3.4.0",
		"@sveltejs/vite-plugin-svelte": "7.3.2",
		"@tailwindcss/vite": "4.3.5",
		"@types/node": "26.6.6",
		"eslint": "10.15.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.24.1",
		"globals": "17.14.0",
		"prettier": "3.10.1",
		"prettier-plugin-svelte": "4.2.0",
		"prettier-plugin-tailwindcss": "0.8.1",
		"svelte": "5.59.1",
		"svelte-check": "4.7.8",
		"tailwindcss": "4.3.5",
		"typescript": "6.0.3",
		"typescript-eslint": "8.74.0",
		"vite": "8.3.8",
		"vitest": "5.1.1"
	},
	"dependencies": {
		"zod": "4.6.7"
	}
}
